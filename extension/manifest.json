{
  "manifest_version": 3,
  "name": "AI Ready Tools Extension",
  "version": "1.0.0",
  "description": "Saved prompts and skills for claude.ai in a sidebar, plus optional team prompt sharing. Nothing is sent automatically.",
  "key": "",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://claude-extension-xi.vercel.app/*",
    "https://innocent-lamb-6401.clerk.accounts.dev/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content-script.ts-CU5mgUo9.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "resources": [
        "assets/content-script.ts-CU5mgUo9.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
